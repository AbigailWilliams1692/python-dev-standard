# Copy to .env for local runs. Never commit the real .env.
AI_ASSISTANT_APP_NAME=ai-assistant
AI_ASSISTANT_APP_ENV=dev
AI_ASSISTANT_LOG_LEVEL=INFO
AI_ASSISTANT_LOG_JSON=false

# fake keeps the service runnable without any vendor account
AI_ASSISTANT_LLM_PROVIDER=fake
AI_ASSISTANT_LLM_API_KEY=
AI_ASSISTANT_LLM_BASE_URL=https://api.openai.com/v1
AI_ASSISTANT_LLM_TIMEOUT_SECONDS=30
AI_ASSISTANT_LLM_MAX_RETRIES=2

AI_ASSISTANT_CHAT_DEFAULT_MODEL=gpt-4o-mini
AI_ASSISTANT_CHAT_MAX_TURNS=40
AI_ASSISTANT_CHAT_MAX_MESSAGE_CHARS=8000
