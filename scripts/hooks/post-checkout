#!/bin/sh
# ############################################################################
# @Project: python-dev-standard
# @File Path: scripts/hooks/post-checkout
# @Description: Rebuild hard-linked files after a checkout. A checkout
#   rewrites files in place, so a hard link (same inode, two paths) silently
#   degrades into two independent copies. This hook restores the link.
#   Only runs when $GIT_DIR/agents-links exists; the file is machine-local
#   and deliberately not tracked, because link targets are absolute paths.
# @Creation Date: 2026-11-18
# @Last Update: 2026-11-18
# ############################################################################

# Git exports GIT_DIR; fall back to the usual location when invoked by hand
git_dir=${GIT_DIR:-.git}
link_conf="$git_dir/agents-links"

# 没有清单说明这台机器没配置链接，静默通过，不影响普通仓库
[ -f "$link_conf" ] || exit 0

# 只在 NTFS 上需要这套机制，其他平台硬链接不会因重写而断开
case "$(uname -s)" in
    MSYS* | MINGW* | CYGWIN*) : ;;
    *) exit 0 ;;
esac

warn() {
    printf 'post-checkout: %s\n' "$1" >&2
}

# 逐条处理「源文件 <TAB> 目标路径」，空行与 # 注释跳过
while IFS='	' read -r src dst; do
    case "$src" in
        '' | '#'*) continue ;;
    esac

    # 目标列缺失说明清单写坏了，报出来而不是猜
    if [ -z "$dst" ]; then
        warn "malformed line in agents-links: $src"
        continue
    fi

    # 源文件被删除时无法建链，提示但不中断其余条目
    if [ ! -f "$src" ]; then
        warn "source missing, skipped: $src"
        continue
    fi

    # 目标已存在且与源同 inode，说明链接完好，无需动作
    if [ -f "$dst" ]; then
        src_id=$(stat -c '%d:%i' "$src" 2>/dev/null)
        dst_id=$(stat -c '%d:%i' "$dst" 2>/dev/null)
        if [ -n "$src_id" ] && [ "$src_id" = "$dst_id" ]; then
            continue
        fi

        # 内容不一致说明目标被独立改过，先备份再重建，避免丢用户改动
        if ! cmp -s "$src" "$dst"; then
            backup="$dst.bak.$(date +%Y%m%d-%H%M%S)"
            cp -p "$dst" "$backup" || warn "backup failed: $dst"
            warn "divergent copy backed up to $backup"
        fi

        rm -f "$dst" || { warn "cannot remove stale copy: $dst"; continue; }
    fi

    # 目标父目录可能在全新 clone 中不存在
    mkdir -p "$(dirname "$dst")" || { warn "cannot create $dst parent"; continue; }

    # fsutil 是 Windows 原生工具，路径必须是反斜杠形式
    if fsutil hardlink create "$(cygpath -w "$dst")" "$(cygpath -w "$src")" \
        >/dev/null 2>&1; then
        warn "relinked $dst"
        continue
    fi

    # 兜底用 mklink，两者失败才认为真的建不了
    if cmd //c mklink /H "$(cygpath -w "$dst")" "$(cygpath -w "$src")" \
        >/dev/null 2>&1; then
        warn "relinked $dst (mklink)"
        continue
    fi

    warn "failed to link $dst -> $src"
done <"$link_conf"

exit 0
